# Copy to /opt/tpqr/.env on the ECS server and chmod 600 it.
ENVIRONMENT=production
TPQR_DOMAIN=replace-with-your-domain
APP_ORIGIN=https://replace-with-your-domain
PUBLIC_QR_ORIGIN=https://replace-with-your-domain
AUTH_OAUTH_CALLBACK_ORIGIN=https://replace-with-your-domain
AUTH_DELIVERY_MODE=resend
RESEND_API_KEY=replace-with-your-resend-secret
RESEND_FROM_EMAIL=replace-with-your-verified-sender
AUTH_ALLOWED_EMAILS=*
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret

# Assets use the persistent local filesystem at TPQR_ASSET_PATH by default.
# OSS is optional; if used, set all four values below and restrict the RAM user
# to this bucket. Leave all four blank to keep using local storage.
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

AUTH_GITHUB_CLIENT_ID=replace-with-your-github-client-id
AUTH_GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
# Google OAuth is retained for future use; the UI button is intentionally hidden.
AUTH_GOOGLE_CLIENT_ID=replace-with-your-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
TPQR_DATABASE_PATH=/data/tpqr/tpqr.sqlite
TPQR_ASSET_PATH=/data/tpqr/assets
PORT=8787
HOST=0.0.0.0
